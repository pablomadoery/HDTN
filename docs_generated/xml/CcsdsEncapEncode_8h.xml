        <name>GetCcsdsEncapHeader</name>
        <param>
          <type>const <ref refid="CcsdsEncap_8h_1a791481082c38ed528aa0d768bbad97b5" kindref="member">ENCAP_PACKET_TYPE</ref></type>
          <declname>type</declname>
