        <name>PopulateReportSegment</name>
        <param>
          <type>const <ref refid="classFragmentSet_1ab9205d52d6ea62686899e767129fadbc" kindref="member">data_fragment_set_t</ref> &amp;</type>
          <declname>fragmentSet</declname>
