        <type>BOOST_FORCEINLINE uint8_t</type>
        <definition>static BOOST_FORCEINLINE uint8_t DecodeCcsdsEncapHeaderSizeFromFirstByte</definition>
        <argsstring>(const ENCAP_PACKET_TYPE type, const uint8_t firstByte)</argsstring>
        <name>DecodeCcsdsEncapHeaderSizeFromFirstByte</name>
        <param>
          <type>const <ref refid="CcsdsEncap_8h_1a791481082c38ed528aa0d768bbad97b5" kindref="member">ENCAP_PACKET_TYPE</ref></type>
          <declname>type</declname>
        </param>
        <param>
          <type>const uint8_t</type>
          <declname>firstByte</declname>
        </param>
        <briefdescription>
        </briefdescription>
        <detaileddescription>
<para>Decode the first byte of a CCSDS Encap header. See <ref refid="CcsdsEncap_8h" kindref="compound">CcsdsEncap.h</ref> for a picture description of the packet.</para>
<para><parameterlist kind="param"><parameteritem>
<parameternamelist>
<parametername>type</parametername>
</parameternamelist>
<parameterdescription>
<para>The non-idle SANA type of encap packet expected to be decoded. </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername>firstByte</parametername>
</parameternamelist>
<parameterdescription>
<para>The first byte of the Encap header to decode. </para>
</parameterdescription>
</parameteritem>
</parameterlist>
<simplesect kind="return"><para>1, 2, 4, or 8 on success (denoting the size of the encap header), or 0 on failure. </para>
</simplesect>
</para>
        </detaileddescription>
